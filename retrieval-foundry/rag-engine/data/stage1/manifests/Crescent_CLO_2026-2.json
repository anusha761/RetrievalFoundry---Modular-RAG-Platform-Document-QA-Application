            "r": 535.3519287109375,
            "b": 627.0399780273438,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            447
          ]
        }
      ],
      "text": "The portfolio is managed with a focus on senior secured loans, which must represent at least 90% of the total collateral balance. The Weighted Average Spread (WAS) trigger is 3.50%, and the Moody's Weighted Average Rating Factor (WARF) is capped at 3,100. The Diversity Score for the portfolio is targeted at 65, ensuring no single industry or obligor dominates the credit risk. The single obligor limit is 2.0% of the aggregate principal balance."
    },
