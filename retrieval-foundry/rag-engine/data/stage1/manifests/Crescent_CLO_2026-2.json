          "charspan": [
            0,
            34
          ]
        }
      ],
      "text": "3. Coverage and Interest Diversion"
    },
    {
      "element_index": 11,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/12",
      "hierarchy_level": 2,
      "page_start": 2,
      "page_end": 2,
      "provenance": [
        {
          "page_no": 2,
          "bbox": {
            "l": 59.7599983215332,
            "t": 579.719970703125,
            "r": 535.3499755859375,
            "b": 502.41998291015625,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            488
          ]
        }
      ],
      "text": "To protect senior noteholders, the transaction features Overcollateralization (OC) and Interest Coverage (IC) tests. The Class A/B OC test has a required threshold of 122.5%. Failure of any OC test results in the redirection of interest proceeds to pay down the principal of senior notes. Additionally, during the reinvestment period, an Interest Diversion Test is applied; if the Class E OC ratio falls below 106.5%, a portion of interest is redirected to purchase additional collateral."
    },
