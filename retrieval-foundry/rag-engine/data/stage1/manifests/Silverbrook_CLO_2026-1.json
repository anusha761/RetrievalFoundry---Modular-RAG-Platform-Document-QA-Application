            "t": 734.365966796875,
            "r": 158.45399475097656,
            "b": 724.14599609375,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            15
          ]
        }
      ],
      "text": "6. Risk Factors"
    },
    {
      "element_index": 26,
      "element_type": "SectionHeaderItem",
      "label": "section_header",
      "self_ref": "#/texts/31",
      "hierarchy_level": 2,
