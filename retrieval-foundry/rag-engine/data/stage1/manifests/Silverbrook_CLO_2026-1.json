        {
          "page_no": 2,
          "bbox": {
            "l": 59.80500030517578,
            "t": 599.8889770507812,
            "r": 238.15896606445312,
            "b": 591.8590087890625,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            33
          ]
        }
      ],
      "text": "2.2 The Trustee and Administrator"
    },
    {
      "element_index": 10,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/11",
      "hierarchy_level": 3,
      "page_start": 2,
      "page_end": 2,
      "provenance": [
        {
          "page_no": 2,
          "bbox": {
            "l": 59.709999084472656,
            "t": 576.8800048828125,
            "r": 535.895751953125,
            "b": 518.4700317382812,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            338
          ]
        }
      ],
      "text": "Meridian Trust & Savings, N.A. serves as the Trustee, Collateral Administrator, and Paying Agent. They are responsible for the safe custody of assets and the calculation of the monthly and payment-date reports. Their role is primarily administrative and fiduciary, ensuring that the priority of payments is respected as per the Indenture."
    },
    {
      "element_index": 11,
      "element_type": "SectionHeaderItem",
      "label": "section_header",
      "self_ref": "#/texts/12",
      "hierarchy_level": 2,
      "page_start": 2,
      "page_end": 2,
      "provenance": [
        {
          "page_no": 2,
          "bbox": {
            "l": 59.80500030517578,
            "t": 497.93798828125,
            "r": 235.43096923828125,
            "b": 487.6309814453125,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            32
          ]
        }
      ],
      "text": "2.3 Legal and Regulatory Counsel"
    },
    {
      "element_index": 12,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/13",
      "hierarchy_level": 3,
      "page_start": 2,
      "page_end": 2,
      "provenance": [
        {
          "page_no": 2,
          "bbox": {
