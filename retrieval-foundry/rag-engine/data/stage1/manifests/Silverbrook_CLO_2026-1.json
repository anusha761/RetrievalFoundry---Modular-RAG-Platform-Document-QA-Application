          ]
        }
      ],
      "text": "6.1 Credit and Default Risk"
    },
    {
      "element_index": 27,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/32",
      "hierarchy_level": 3,
      "page_start": 4,
      "page_end": 4,
      "provenance": [
        {
          "page_no": 4,
          "bbox": {
            "l": 59.709999084472656,
            "t": 678.9300537109375,
            "r": 535.3497314453125,
            "b": 618.5299682617188,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            396
          ]
        }
      ],
      "text": "Investment in the notes is speculative and involves a high degree of risk. The notes are limited-recourse obligations of the Issuer. The primary risk is the potential for defaults among the underlying corporate borrowers. Defaults reduce the principal balance available to pay the notes and may cause the coverage tests to fail, leading to an interruption in interest payments for junior classes."
    },
    {
      "element_index": 28,
      "element_type": "SectionHeaderItem",
      "label": "section_header",
