            "t": 411.34197998046875,
            "r": 331.64794921875,
            "b": 398.2239990234375,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            43
          ]
        }
      ],
      "text": "3. Collateral Eligibility and Concentration"
    },
    {
      "element_index": 14,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/15",
      "hierarchy_level": 2,
      "page_start": 2,
      "page_end": 2,
      "provenance": [
        {
          "page_no": 2,
          "bbox": {
            "l": 59.7599983215332,
            "t": 381.2900085449219,
            "r": 535.352783203125,
            "b": 320.8900146484375,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            400
          ]
        }
      ],
      "text": "The portfolio consists primarily of broadly syndicated senior secured loans. An 'Eligible Collateral Obligation' must satisfy several conditions: (i) it must be denominated in U.S. Dollars; (ii) it must not be a defaulted obligation at the time of purchase; (iii) it must have a minimum rating of B3/B- from at least one agency; and (iv) it must not be a bridge loan or a structured finance security."
    },
    {
      "element_index": 15,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/16",
      "hierarchy_level": 2,
      "page_start": 2,
      "page_end": 2,
      "provenance": [
        {
          "page_no": 2,
          "bbox": {
            "l": 60.029998779296875,
            "t": 304.75,
            "r": 535.687744140625,
            "b": 244.36000061035156,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            380
          ]
        }
      ],
      "text": "Concentration limits apply to ensure diversity. No single obligor may exceed 2.0% of the portfolio. The top 10 obligors collectively may not exceed 15.0%. Furthermore, industry-specific concentrations are capped at 12.0% for most GICS categories, with the exception of 'Software and Services' which is permitted up to 15.0% due to the Manager's historical expertise in the sector."
    },
    {
      "element_index": 16,
      "element_type": "SectionHeaderItem",
      "label": "section_header",
      "self_ref": "#/texts/19",
      "hierarchy_level": 1,
      "page_start": 3,
      "page_end": 3,
      "provenance": [
        {
          "page_no": 3,
          "bbox": {
            "l": 59.795997619628906,
            "t": 734.4920043945312,
            "r": 342.0499572753906,
            "b": 721.3739624023438,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            43
          ]
        }
      ],
      "text": "4. Structural Protections and Quality Tests"
    },
    {
      "element_index": 17,
      "element_type": "SectionHeaderItem",
      "label": "section_header",
      "self_ref": "#/texts/20",
      "hierarchy_level": 2,
      "page_start": 3,
      "page_end": 3,
      "provenance": [
        {
          "page_no": 3,
          "bbox": {
            "l": 59.73899841308594,
            "t": 702.0280151367188,
            "r": 304.2689208984375,
            "b": 691.7210083007812,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            47
          ]
        }
      ],
      "text": "4.1 Overcollateralization and Interest Coverage"
    },
    {
      "element_index": 18,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/21",
      "hierarchy_level": 3,
      "page_start": 3,
      "page_end": 3,
      "provenance": [
        {
          "page_no": 3,
          "bbox": {
            "l": 59.7599983215332,
            "t": 678.9300537109375,
            "r": 535.369873046875,
            "b": 618.5299682617188,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            409
          ]
        }
      ],
      "text": "The Transaction employs a series of coverage tests to protect senior noteholders. The Class A/B Overcollateralization (OC) Test requires the ratio of the Adjusted Collateral Principal Balance to the principal of Class A and B notes to be at least 121.5%. If the ratio falls below this level, interest proceeds are redirected to pay down the principal of the Class A notes until the test is back in compliance."
    },
    {
      "element_index": 19,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/22",
      "hierarchy_level": 3,
      "page_start": 3,
      "page_end": 3,
      "provenance": [
        {
          "page_no": 3,
          "bbox": {
            "l": 59.709999084472656,
            "t": 602.3900146484375,
            "r": 535.3800048828125,
            "b": 559.0,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            284
          ]
        }
      ],
      "text": "The Interest Coverage (IC) Tests operate similarly but measure the ratio of available interest collections to the interest due on the senior notes. The Class A/B IC trigger is 120.0%, and the Class C IC trigger is 115.0%. These tests are measured quarterly on each Determination Date."
    },
    {
      "element_index": 20,
      "element_type": "SectionHeaderItem",
      "label": "section_header",
      "self_ref": "#/texts/23",
      "hierarchy_level": 2,
      "page_start": 3,
      "page_end": 3,
      "provenance": [
        {
          "page_no": 3,
          "bbox": {
            "l": 59.73899841308594,
            "t": 540.4580078125,
            "r": 199.61497497558594,
            "b": 530.1510009765625,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            28
          ]
        }
      ],
      "text": "4.2 Collateral Quality Tests"
    },
    {
      "element_index": 21,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/24",
      "hierarchy_level": 3,
      "page_start": 3,
      "page_end": 3,
      "provenance": [
        {
          "page_no": 3,
          "bbox": {
            "l": 59.529998779296875,
            "t": 517.3500366210938,
            "r": 535.68994140625,
            "b": 441.9300231933594,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            441
          ]
        }
      ],
      "text": "In addition to coverage tests, the Manager must maintain specific portfolio quality levels. The Weighted Average Rating Factor (WARF) must not exceed 2,950. The Weighted Average Spread (WAS) must be at least 3.45%. The Weighted Average Life (WAL) of the portfolio is limited to 8.2 years from the Closing Date. Finally, the Diversity Score must be at least 62, reflecting a broad distribution of credit risk across distinct economic sectors."
    },
    {
      "element_index": 22,
      "element_type": "SectionHeaderItem",
      "label": "section_header",
      "self_ref": "#/texts/25",
      "hierarchy_level": 1,
      "page_start": 3,
      "page_end": 3,
      "provenance": [
        {
          "page_no": 3,
          "bbox": {
            "l": 60.145999908447266,
            "t": 419.6839904785156,
            "r": 279.5119934082031,
            "b": 406.916015625,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            30
          ]
        }
      ],
      "text": "5. Reinvestment and Redemption"
    },
    {
      "element_index": 23,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/26",
      "hierarchy_level": 2,
      "page_start": 3,
      "page_end": 3,
      "provenance": [
        {
          "page_no": 3,
          "bbox": {
            "l": 59.7599983215332,
            "t": 389.7900085449219,
            "r": 535.3837890625,
            "b": 346.4100036621094,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            267
          ]
        }
      ],
      "text": "The Reinvestment Period spans five years, during which the Manager can reinvest principal collections and sale proceeds into new Collateral Obligations. After this period, principal proceeds are used solely to amortize the notes sequentially, starting with Class A-1."
    },
    {
      "element_index": 24,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/27",
      "hierarchy_level": 2,
      "page_start": 3,
      "page_end": 3,
      "provenance": [
        {
          "page_no": 3,
          "bbox": {
            "l": 59.91999816894531,
            "t": 330.27001953125,
            "r": 535.3528442382812,
            "b": 286.8800048828125,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            291
          ]
        }
      ],
      "text": "Optional Redemption is available after the 2-year non-call period. Subordinated Noteholders may direct the Issuer to redeem the notes in whole or in part (via refinancing). A 'Clean-up Call' is also available if the collateral balance drops below 10% of the initial Target Portfolio balance."
    },
    {
      "element_index": 25,
      "element_type": "SectionHeaderItem",
      "label": "section_header",
      "self_ref": "#/texts/30",
      "hierarchy_level": 1,
      "page_start": 4,
      "page_end": 4,
