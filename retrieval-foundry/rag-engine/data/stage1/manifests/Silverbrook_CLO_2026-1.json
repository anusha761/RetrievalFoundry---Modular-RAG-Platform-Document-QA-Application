            22
          ]
        }
      ],
      "text": "6.4 Subordination Risk"
    },
    {
      "element_index": 33,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/38",
      "hierarchy_level": 3,
      "page_start": 4,
