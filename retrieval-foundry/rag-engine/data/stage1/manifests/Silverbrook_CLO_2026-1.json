          ]
        }
      ],
      "text": "2.1 The Manager"
    },
    {
      "element_index": 8,
      "element_type": "TextItem",
      "label": "text",
      "self_ref": "#/texts/9",
      "hierarchy_level": 3,
      "page_start": 2,
      "page_end": 2,
      "provenance": [
        {
          "page_no": 2,
          "bbox": {
            "l": 59.709999084472656,
            "t": 678.9300537109375,
            "r": 535.3497924804688,
            "b": 618.5299682617188,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            354
          ]
        }
      ],
      "text": "Silverbrook Asset Management LLC is a Delaware limited liability company specialized in credit-focused alternative investments. As Collateral Manager, they will manage the portfolio and provide administrative support. The Manager's duties include identifying eligible loans, monitoring credit quality, and executing trades during the reinvestment period."
    },
    {
      "element_index": 9,
      "element_type": "SectionHeaderItem",
      "label": "section_header",
      "self_ref": "#/texts/10",
      "hierarchy_level": 2,
      "page_start": 2,
