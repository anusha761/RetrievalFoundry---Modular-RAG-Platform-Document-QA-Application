            "t": 372.7799987792969,
            "r": 535.36083984375,
            "b": 312.3900146484375,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            376
          ]
        }
      ],
      "text": "Junior notes (Classes C, D, and E) are subordinated to the Class A and B notes. In the event of a liquidation of the portfolio, junior noteholders will only receive proceeds after all senior obligations, including administrative expenses and senior interest/principal, have been paid in full. Subordinated Noteholders (Equity) face the highest risk of total loss of principal."
    },
