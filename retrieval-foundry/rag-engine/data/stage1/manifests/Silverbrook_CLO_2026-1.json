            "t": 474.8299865722656,
            "r": 535.3677978515625,
            "b": 431.55999755859375,
            "coord_origin": "CoordOrigin.BOTTOMLEFT"
          },
          "charspan": [
            0,
            241
          ]
        }
      ],
      "text": "Legal counsel to the Issuer is Ashford & Gable LLP. Manager counsel is Reed & Vance, P.C. These firms have coordinated to ensure compliance with relevant securitization regulations, including risk retention requirements and the Volcker Rule."
    },
    {
      "element_index": 13,
      "element_type": "SectionHeaderItem",
      "label": "section_header",
      "self_ref": "#/texts/14",
      "hierarchy_level": 1,
      "page_start": 2,
